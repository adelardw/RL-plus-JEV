  "trl==1.13.0",
  "transformers==5.17.0",
  "datasets==5.0.1",
  "httpx"
 ],
 "jobs": [
  {
   "name": "selftest",
   "command": "scripts/guard.py --name selftest --timeout 900 --silence-timeout 420 --heartbeat 60 -- scripts/kaggle_selftest.py",
   "est_seconds": 600,
   "why": "environment, secret, Jev reachability and throughput before anything expensive",
   "needs_api": true
  },
  {
   "name": "gpu-benchmark",
   "command": "scripts/guard.py --name gpu-benchmark --timeout 3000 --silence-timeout 900 --heartbeat 120 -- scripts/gpu_benchmark.py --steps 5 --grpo-prompts 16 --grpo-g 8 --ppo-prompts 64 --max-new 384 --micro-bs 8 --gen-bs 16 --skip-vllm --out /kaggle/working/results/gpu_benchmark.json",
   "est_seconds": 1800,
   "why": "seconds per step for GRPO and PPO at the real settings, so the study can be scheduled from measurement",
   "needs_api": false
  },
  {
   "name": "judge-benchmark",
   "command": "scripts/guard.py --name judge-benchmark --timeout 5400 --silence-timeout 1200 --heartbeat 120 -- scripts/judge_benchmark.py --n 300 --judges Qwen/Qwen2.5-1.5B-Instruct,Qwen/Qwen2.5-3B-Instruct,Qwen/Qwen2.5-7B-Instruct --out /kaggle/working/results/judge_benchmark.json",
   "est_seconds": 3600,
   "why": "picks the RLAIF judge on evidence: the smallest judge that separates chosen from rejected",
   "needs_api": true
  },
  {
   "name": "calibration-study",
   "command": "scripts/guard.py --name calibration-study --timeout 3600 --silence-timeout 900 --heartbeat 120 -- scripts/calibration_study.py --n 256 --max-new-tokens 256 --out /kaggle/working/results/calibration_study.json",
   "est_seconds": 2400,
   "why": "Experiment 1 at full size: is Jev's prefix probability a value function?",
   "needs_api": true
  }
 ],
 "reserve_seconds": 1200,
 "done": []
}